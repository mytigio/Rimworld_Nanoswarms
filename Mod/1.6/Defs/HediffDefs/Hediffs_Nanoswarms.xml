<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef Parent="Hediff_AndroidReactor">
        <defName>mytNS_NanoswarmProjectionBody</defName>
        <label>Nanoswarm Projection</label>
        <hediffClass>Nanoswarms.mytNS_NanoswarmProjectionBody</hediffClass>
        <description>This body is in fact a swarm of nanoscale robots shaped to resemble a human.  As a result, the body is resistant to blunt and cutting damage, however the miroscopic robots are very vulnerable to fire and EMP damage.  The body is robotic, and is thus immune to most disease, does not require food or sleep.  The body is actually a projection controlled by a mind in a projection cabinet, and as such if destroyed, a new body can simply be formed from a new swarm of nanites.</description>
        <descriptionShort>This body is in fact a swarm of nanoscale robots shaped to resemble a human.  As it is robotic in nature it lacks many of the needs of an organic body.</descriptionShort>
        <countsAsAddedPartOrImplant>true</countsAsAddedPartOrImplant>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <totalBleedFactor>0.1</totalBleedFactor>
                <naturalHealingFactor>0</naturalHealingFactor>
                <statFactors>
                    <MarketValue>0</MarketValue>
                    <ToxicResistance>1</ToxicResistance>
                    <Flammability>2.0</Flammability>
                    <MeatAmount>0</MeatAmount>
                    <LeatherAmount>0</LeatherAmount>
                    <RoyalFavorValue>0</RoyalFavorValue>
                    <LifespanFactor>500</LifespanFactor>
                    <ArmorRating_Heat>0</ArmorRating_Heat>
                </statFactors>
                <statOffsets>
                    <ComfyTemperatureMin>-30</ComfyTemperatureMin>
                    <ComfyTemperatureMax>30</ComfyTemperatureMax>
                    <ArmorRating_Sharp>1.45</ArmorRating_Sharp>
                    <ArmorRating_Blunt>1.45</ArmorRating_Blunt>
                </statOffsets>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_ReactOnDamage">
                <damageDefIncoming>EMP</damageDefIncoming>
                <createHediff>mytNS_EMPBurst</createHediff>
            </li>
        </comps>
    </HediffDef>
    <HediffDef>
        <defName>mytNS_Desynchronization</defName>
        <label>Desynchronization</label>
        <hediffClass>HediffWithComps</hediffClass>
        <description>Disorientation stemming from being powered down for an extended period.  Causes confusion and difficulty controlling the projection swarm due to wave-form synchronization errors.  This synchronization error will correct naturally given enough time.</description>
        <defaultLabelColor>(0.6, 0.6, 0.6)</defaultLabelColor>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.25</severityPerDay>
            </li>
        </comps>
        <stages>
            <li>
                <label>desync</label>
                <becomeVisible>false</becomeVisible>
            </li>
            <li>
                <label>minor latency</label>
                <minSeverity>0.04</minSeverity>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.08</offset>
                    </li>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>-0.05</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>lag spikes</label>
                <minSeverity>0.2</minSeverity>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.1</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.2</offset>
                    </li>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>-0.10</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>persistent latency</label>
                <minSeverity>0.35</minSeverity>
                <painOffset>0.15</painOffset>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.3</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.5</offset>
                    </li>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>-0.20</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>full desynchronization</label>
                <minSeverity>0.62</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.1</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
    <HediffDef>
        <defName>mytNS_EMPBurst</defName>
        <label>emp burst</label>
        <labelNoun>an emp burst</labelNoun>
        <description>An emp burst that destroyed the nanites of a nanoswarm projection.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <comps>
            <li Class="Nanoswarms.mytNS_HediffCompProperties_DisableNanoSwarm" />
        </comps>
    </HediffDef>
    
    <!-- Skill hediffs -->
    <HediffDef ParentName="ImplantHediffBase">
        <defName>mytNS_melee10</defName>
        <label>nanite armblade</label>
        <labelNoun>a nanite armblade</labelNoun>
        <description>The microscopic robots along the manipulator appendage of the swarm form into a hardened blade at a thought.</description>
        <comps>
            <li Class="HediffCompProperties_VerbGiver">
                <tools>
                    <li>
                        <label>nanite armblade</label>
                        <capacities>
                            <li>Stab</li>
                        </capacities>
                        <power>23</power> <!-- nanoscale robots are sharp and deadly. -->
                        <armorPenetration>0.5</armorPenetration>
                        <cooldownTime>2.6</cooldownTime>
                        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
                        <soundMeleeHit>MeleeHit_BionicSlash</soundMeleeHit>
                        <soundMeleeMiss>MeleeMiss_BionicSlash</soundMeleeMiss>
                    </li>
                    <li>
                        <label>nanite armblade</label>
                        <capacities>
                            <li>Slice</li>
                        </capacities>
                        <power>23</power> <!-- nanoscale robots are sharp and deadly. -->
                        <armorPenetration>0.5</armorPenetration>
                        <cooldownTime>2.6</cooldownTime>
                        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
                        <soundMeleeHit>MeleeHit_BionicSlash</soundMeleeHit>
                        <soundMeleeMiss>MeleeMiss_BionicSlash</soundMeleeMiss>
                    </li>
                </tools>
            </li>
        </comps>
    </HediffDef>
    <HediffDef ParentName="ImplantHediffBase">
        <defName>mytNS_melee20</defName>
        <label>nanite monoblade</label>
        <labelNoun>a nanite monoblade</labelNoun>
        <description>The microscopic robots along the manipulator appendage of the swarm form into a hardened blade at a thought, forming into a monosword at a moments notice.</description>
        <comps>
            <li Class="HediffCompProperties_VerbGiver">
                <tools>
                    <li>
                        <label>nanite monoblade</label>
                        <capacities>
                            <li>Stab</li>
                        </capacities>
                        <power>35</power> <!-- nanoscale robots are sharp and deadly. -->
                        <armorPenetration>0.90</armorPenetration>
                        <cooldownTime>2</cooldownTime>
                        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
                        <soundMeleeHit>MeleeHit_BionicSlash</soundMeleeHit>
                        <soundMeleeMiss>MeleeMiss_BionicSlash</soundMeleeMiss>
                    </li>
                    <li>
                        <label>nanite monoblade</label>
                        <capacities>
                            <li>Slice</li>
                        </capacities>
                        <power>35</power> <!-- nanoscale robots are sharp and deadly. -->
                        <armorPenetration>0.90</armorPenetration>
                        <cooldownTime>2</cooldownTime>
                        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
                        <soundMeleeHit>MeleeHit_BionicSlash</soundMeleeHit>
                        <soundMeleeMiss>MeleeMiss_BionicSlash</soundMeleeMiss>
                    </li>
                </tools>
            </li>
        </comps>
    </HediffDef>
</Defs>