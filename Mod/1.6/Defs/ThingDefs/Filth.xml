<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <ThingDef ParentName="BaseFilth" Name="mytNS_Filth_Nanodust">
		<defName>mytNS_Filth_Nanodust</defName>
		<label>nanite dust</label>
		<statBases>
			<Beauty>-20</Beauty>
			<Cleanliness>-5</Cleanliness>
		</statBases>
		<graphicData>
			<texPath>Things/Filth/Spatter</texPath>
			<color>(128, 128, 128)</color>
		</graphicData>
		<filth>
			<ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
			<disappearsInDays>5~10</disappearsInDays>
			<rainWashes>true</rainWashes>
			<cleaningWorkToReduceThickness>35</cleaningWorkToReduceThickness>
			<canFilthAttach>true</canFilthAttach>
			<cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
		</filth>
	</ThingDef>
	<ThingDef ParentName="mytNS_Filth_Nanodust">
    <defName>mytNS_Filth_NanodustSmear</defName>
    <label>nanite dust smear</label>
    <graphicData>
      <texPath>Things/Filth/CrawlSmear</texPath>
      <color>(128, 128, 128)</color>
      <graphicClass>Graphic_ClusterTight</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
  </ThingDef>
</Defs>
