<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <DamageDef Name="mytNS_Disintegrate">
    <defName>mytNS_Disintegrate</defName>
    <label>disintegrate</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been disintegrated by a nanoswarm.</deathMessage>
    <hediff>mytNS_DisintegrationBurn</hediff>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <defaultDamage>400</defaultDamage>
    <defaultStoppingPower>1.5</defaultStoppingPower>
    <defaultArmorPenetration>0.80</defaultArmorPenetration>
    <buildingDamageFactorImpassable>2</buildingDamageFactorImpassable>
    <buildingDamageFactorPassable>1</buildingDamageFactorPassable>
    <plantDamageFactor>2</plantDamageFactor>
    <explosionHeatEnergyPerCell>10</explosionHeatEnergyPerCell>
    <explosionCellFleck>Fleck_Vaporize</explosionCellFleck>
    <armorCategory>Sharp</armorCategory>
    <minDamageToFragment>15</minDamageToFragment>
    <makesAnimalsFlee>true</makesAnimalsFlee>
    <explosionColorCenter>(0.3, 0.3, 0.3)</explosionColorCenter>
    <explosionColorEdge>(0.8, 0.8, 0.8)</explosionColorEdge>
    <soundExplosion>Explosion_Vaporize</soundExplosion>
    <expolosionPropagationSpeed>0.2</expolosionPropagationSpeed>
    <hasForcefulImpact>true</hasForcefulImpact>
    <corpseDamageFactor>0.1</corpseDamageFactor>
    <scaleDamageToBuildingsBasedOnFlammability>false</scaleDamageToBuildingsBasedOnFlammability>
  </DamageDef>

  <DamageDef Name="mytNS_DisintegrateSelf">
    <defName>mytNS_DisintegrateSelf</defName>
    <label>disintegrate</label>
    <workerClass>DamageWorker_MiningBomb</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been disintegrated by a nanoswarm.</deathMessage>
    <hediff>mytNS_DisintegrationBurn</hediff>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <defaultDamage>4000</defaultDamage>
    <defaultStoppingPower>1.5</defaultStoppingPower>
    <defaultArmorPenetration>0.3</defaultArmorPenetration>
    <buildingDamageFactorImpassable>30</buildingDamageFactorImpassable>
    <buildingDamageFactorPassable>5</buildingDamageFactorPassable>
    <plantDamageFactor>10</plantDamageFactor>
    <explosionHeatEnergyPerCell>0</explosionHeatEnergyPerCell>
    <explosionCellFleck>Fleck_Vaporize</explosionCellFleck>
    <armorCategory>Sharp</armorCategory>
    <minDamageToFragment>15</minDamageToFragment>
    <makesAnimalsFlee>true</makesAnimalsFlee>
    <explosionColorCenter>(0.3, 0.3, 0.3)</explosionColorCenter>
    <explosionColorEdge>(0.8, 0.8, 0.8)</explosionColorEdge>
    <soundExplosion>Explosion_Vaporize</soundExplosion>
    <expolosionPropagationSpeed>0.2</expolosionPropagationSpeed>
    <hasForcefulImpact>true</hasForcefulImpact>
    <corpseDamageFactor>1</corpseDamageFactor>
    <scaleDamageToBuildingsBasedOnFlammability>false</scaleDamageToBuildingsBasedOnFlammability>
  </DamageDef>
</Defs>
