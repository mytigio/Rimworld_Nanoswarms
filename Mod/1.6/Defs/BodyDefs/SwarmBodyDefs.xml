	<BodyDef>
		<defName>mytNS_SwarmHuman</defName>
		<label>nanoswarm</label>
		<corePart>
			<def>mytNS_swarmCloud</def>
			<customLabel>swarm</customLabel>
			<height>Middle</height>
			<depth>Outside</depth>
			<groups>
				<li>Torso</li>
				<li>Waist</li>
			</groups>
			<parts>
				<li>
					<def>Neck</def>
					<coverage>0.075</coverage>
					<height>Top</height>
					<groups>
						<li>Neck</li>
					</groups>
					<parts>
						<li>
							<def>Head</def>
							<coverage>0.80</coverage>
							<groups>
								<li>UpperHead</li>
								<li>FullHead</li>
								<li>HeadAttackTool</li>
								<li>Teeth</li>
							</groups>
							<parts>
								<li>
									<def>mytNS_opticalCluster</def>
									<customLabel>optical cluster</customLabel>
									<coverage>0.07</coverage>
									<groups>
										<li>FullHead</li>
										<li>Eyes</li>
									</groups>
									<woundAnchorTag>RightEye</woundAnchorTag>
								</li>
								<li>
									<def>mytNS_vibrationCluster</def>
									<coverage>0.07</coverage>
									<groups>
										<li>UpperHead</li>
										<li>FullHead</li>
									</groups>
								</li>
							</parts>
						</li>
					</parts>
				</li>
				<li>
					<def>mytNS_projector</def>
					<coverage>0.05</coverage>
					<depth>Inside</depth>
					<groups>
						<li>Torso</li>
					</groups>
					<parts>
						<li>
							<def>mytNS_arrayCasing</def>
							<coverage>0.18</coverage>
							<depth>Inside</depth>
							<groups>
								<li>Torso</li>
							</groups>
							<parts>
								<li>
									<def>mytNS_tunnelingArray</def>
									<coverage>0.8</coverage>
									<groups>
										<li>Torso</li>
									</groups>
								</li>
							</parts>
						</li>
					</parts>
				</li>
				<li>
					<def>mytNS_manipulator</def>
					<customLabel>left manipulator</customLabel>
					<coverage>0.77</coverage>
					<flipGraphic>true</flipGraphic>
					<groups>
						<li>Shoulders</li>
						<li>Torso</li>
						<li>Arms</li>
						<li>LeftHand</li>
					</groups>
				</li>
				<li>
					<def>mytNS_manipulator</def>
					<customLabel>right manipulator</customLabel>
					<coverage>0.77</coverage>
					<flipGraphic>true</flipGraphic>
					<groups>
						<li>Arms</li>
						<li>RightHand</li>
					</groups>
				</li>
				<li>
					<def>mytNS_locomotor</def>
					<customLabel>left locomotor</customLabel>
					<coverage>0.77</coverage>
					<flipGraphic>true</flipGraphic>
					<groups>
						<li>Legs</li>
						<li>Feet</li>
					</groups>
				</li>
				<li>
					<def>mytNS_locomotor</def>
					<customLabel>right locomotor</customLabel>
					<coverage>0.77</coverage>
					<flipGraphic>true</flipGraphic>
