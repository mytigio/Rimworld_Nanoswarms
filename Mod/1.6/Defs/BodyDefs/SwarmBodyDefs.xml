	<ThingDef ParentName="Human">
		<defName>mytNS_SwarmProjectionRace</defName>
		<label>swarm</label>
		<description>A swarm of microscopic robots in the form of a human.</description>
		<race>
			<body>mytNS_SwarmHuman</body>
			<useMeatFrom>Human</useMeatFrom>
			<useLeatherFrom>Human</useLeatherFrom>
			<bloodDef>mytNS_Filth_Nanodust</bloodDef>
			<thinkTreeMain>Humanlike</thinkTreeMain>
			<thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
			<intelligence>Humanlike</intelligence>
			<makesFootprints>false</makesFootprints>
			<lifeExpectancy>1000</lifeExpectancy>
			<canBecomeShambler>false</canBecomeShambler>
		</race>
	</ThingDef>
