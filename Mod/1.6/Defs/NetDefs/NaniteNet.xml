<?xml version="1.0" encoding="UTF-8"?>
<Defs>
	<PipeSystem.PipeNetDef>
		<defName>mytNS_NaniteNet</defName>
		<resource>
			<name>Nanite</name>
			<unit>l</unit>
			<color>(127, 127, 127)</color>
			<onlyShowStored>True</onlyShowStored>
			<offTexPath>UI/OutOfNeutroamine</offTexPath>
		</resource>
		<pipeDefs>
			<li>mytNS_NanitePipe</li>
			<li>mytNS_SubterranianNanitePipe</li>
		</pipeDefs>
		<designator>
			<deconstructIconPath>UI/NeutroPipes_Deconstruct</deconstructIconPath>
			<designationCategoryDef>VCHE_PipeNetworks</designationCategoryDef>
		</designator>
		<overlayOptions>
			<overlayColor>(127, 127, 127)</overlayColor>
		</overlayOptions>
		<linkToRefuelables>
			<li>
				<thing>mytNS_NaniteCanister</thing>
				<ratio>1</ratio>
			</li>
		</linkToRefuelables>
	</PipeSystem.PipeNetDef>

	<ThingDef ParentName="BuildingBase">
		<defName>mytNS_NanitePipe</defName>
		<label>nanite pipe</label>
		<description>Sterile pipes for transporting the miniscule robots called nanites to tanks and
			workbenches.</description>
		<thingClass>PipeSystem.Building_Pipe</thingClass>
		<category>Building</category>
		<tickerType>Rare</tickerType>
		<graphicData>
			<texPath>Things/Linked/NeutroPipes_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom9</li>
			</linkFlags>
			<damageData>
				<rect>(0,0.35,1,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Neutro/NeutroPipes_MenuIcon</uiIconPath>
		<uiIconScale>0.7</uiIconScale>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<isEdifice>false</isEdifice>
			<blueprintGraphicData>
				<texPath>Things/Linked/NeutroPipes_Blueprint_Atlas</texPath>
			</blueprintGraphicData>
		</building>
		<drawerType>MapMeshOnly</drawerType>
		<altitudeLayer>Conduits</altitudeLayer>
		<passability>Standable</passability>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<WorkToBuild>40</WorkToBuild>
			<Flammability>1.0</Flammability>
		</statBases>
		<drawStyleCategory>Conduits</drawStyleCategory>
		<costList>
			<Silver>2</Silver>
			<Steel>2</Steel>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>mytNS_NaniteNet</pipeNet>
			</li>
		</comps>
		<placeWorkers>
			<li>PipeSystem.PlaceWorker_Pipe</li>
		</placeWorkers>
		<rotatable>false</rotatable>
		<selectable>true</selectable>
		<neverMultiSelect>true</neverMultiSelect>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>VCHE_PipeNetworks</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<clearBuildingArea>false</clearBuildingArea>
		<researchPrerequisites>
			<li>VREA_NeutroamineLogistics</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>mytNS_SubterranianNanitePipe</defName>
		<label>hidden nanite pipe</label>
		<description>Sterile
		pipes for transporting the miniscule robots called nanites to tanks and workbenches. This
		pipe is hidden from view. More expensive to build than regular pipes.</description>
		<thingClass>
		PipeSystem.Building_Pipe</thingClass>
		<category>Building</category>
		<tickerType>Rare</tickerType>
		<graphicData>
			<texPath>UI/CSG/IConduit</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom8</li>
			</linkFlags>
			<damageData>
				<rect>(0,0.35,1,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>
		Things/Neutro/BuriedNeutroPipes_MenuIcon</uiIconPath>
		<uiIconScale>0.7</uiIconScale>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<isEdifice>false</isEdifice>
			<blueprintGraphicData>
				<texPath>Things/Linked/NeutroPipes_Blueprint_Atlas</texPath>
			</blueprintGraphicData>
			<ai_neverTrashThis>true</ai_neverTrashThis>
			<isTargetable>false</isTargetable>
			<expandHomeArea>false</expandHomeArea>
			<canBeDamagedByAttacks>false</canBeDamagedByAttacks>
		</building>
		<drawerType>
		MapMeshOnly</drawerType>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<passability>
		Standable</passability>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>60</MaxHitPoints>
			<WorkToBuild>320</WorkToBuild>
			<Flammability>0</Flammability>
		</statBases>
		<drawStyleCategory>Conduits</drawStyleCategory>
		<costList>
			<Silver>4</Silver>
			<Steel>4</Steel>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>mytNS_NaniteNet</pipeNet>
			</li>
		</comps>
		<placeWorkers>
			<li>PipeSystem.PlaceWorker_Pipe</li>
		</placeWorkers>
		<rotatable>false</rotatable>
		<selectable>
		true</selectable>f <neverMultiSelect>true</neverMultiSelect>
		<soundImpactDefault>
		BulletImpact_Metal</soundImpactDefault>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>
		VCHE_PipeNetworks</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<clearBuildingArea>
		false</clearBuildingArea>
		<researchPrerequisites>
			<li>VREA_NeutroamineLogistics</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>mytNS_NaniteTank</defName>
		<label>nanite holding tank</label>
		<description>A sterile storage tank meant for storing millions of tiny robots via the pipe
			network. Nanites are much too small to handle manually and must be transported in tanks
			and canisters.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Buildings/NaniteMachines/NaniteStorage_south</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1,1)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<pathCost>50</pathCost>
		<blockWind>true</blockWind>
		<castEdgeShadows>true</castEdgeShadows>
		<fillPercent>0.40</fillPercent>
		<tickerType>Normal</tickerType>
		<statBases>
			<MaxHitPoints>180</MaxHitPoints>
			<WorkToBuild>800</WorkToBuild>
			<Mass>20</Mass>
			<Flammability>1.0</Flammability>
		</statBases>
		<size>(1,1)</size>
		<costList>
			<Silver>200</Silver>
			<Steel>200</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_ResourceStorage">
				<pipeNet>mytNS_NaniteNet</pipeNet>
				<storageCapacity>1000</storageCapacity>
				<barSize>(1.3, 0.25)</barSize>
				<margin>0.1</margin>
				<centerOffset>(0, 0, 0.45)</centerOffset>
			</li>
		</comps>
		<rotatable>false</rotatable>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<designationCategory>VCHE_PipeNetworks</designationCategory>
		<staticSunShadowHeight>0.2</staticSunShadowHeight>
		<constructEffect>ConstructMetal</constructEffect>
		<canOverlapZones>false</canOverlapZones>
		<researchPrerequisites>
			<li>VREA_NeutroamineLogistics</li>
		</researchPrerequisites>
		<disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
	</ThingDef>
</Defs>